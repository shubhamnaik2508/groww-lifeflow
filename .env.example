# Copy to .env.local for local use, or set these in Vercel → Project → Settings → Environment Variables.
# Server-side only. Never prefix these with NEXT_PUBLIC_ and never commit real values.

# Required for the AI Companion. Without it, the app shows the labelled rule-based guide.
GROQ_API_KEY=your_groq_api_key_here
# Pinned model id. Checked against Groq's production model list on 2026-11-07.
GROQ_MODEL=openai/gpt-oss-120b

# Optional kill switch: set to "false" to turn the AI off without removing the key.
# LIFEFLOW_AI_ENABLED=true

# Rate limiting on Vercel. Either configure the shared Upstash limiter (recommended) ...
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token
# LIFEFLOW_RATE_LIMIT_SALT=at_least_32_random_characters_here
# ... or explicitly accept the per-instance memory limiter (best effort, resets on cold start):
# LIFEFLOW_RATE_LIMIT_MODE=memory

# ---- Market Pulse (see MARKET_PULSE.md) ----
# Persistent store for the daily brief: Upstash Redis. Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN;
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN (above) work too.
# KV_REST_API_URL=https://your-instance.upstash.io
# KV_REST_API_TOKEN=your_upstash_token
# Protects /api/market-pulse/refresh; Vercel Cron sends it automatically. At least 16 random characters.
# CRON_SECRET=generate_a_long_random_value
# Index data: no free source permits public display. Set these ONLY after obtaining written permission.
# EODHD_API_TOKEN=your_eodhd_token
# MARKET_DATA_LICENSE_CONFIRMED=true
# MARKET_DATA_ATTRIBUTION=End-of-day index data from EODHD
# Optional news: GNews (confirm the free plan covers this site first). GDELT and SEBI RSS need no key.
# GNEWS_API_KEY=your_gnews_key
# GNEWS_USE_CONFIRMED=true
# MARKET_PULSE_GDELT=false
# Market Pulse open-data mode uses the OECD monthly India share price index by default; set to false to turn it off.
# MARKET_PULSE_OECD=false
# Optional: market videos from the moneycontrol and CNBC-TV18 YouTube channels (YouTube Data API v3 key, server-side only).
# YOUTUBE_API_KEY=your_youtube_data_api_key
